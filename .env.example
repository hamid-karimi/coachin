# CoachIn stack settings. `make up` copies this to .env on first run.
#
# The values below are for LOCAL development only and are safe to share.
# On the VPS, replace every secret:  openssl rand -hex 32
# (hex keeps them URL-safe; they are embedded in database URLs.)

# --- Postgres ---------------------------------------------------------------
# Owner role (coachin_owner): owns the schema and runs migrations.
POSTGRES_PASSWORD=dev-owner-password
# API role (coachin_app): what the running API connects as; RLS applies to it.
APP_DB_PASSWORD=dev-app-password
# Auth role (coachin_auth): login/registration only (accounts + sessions).
AUTH_DB_PASSWORD=dev-auth-password

# --- Garage object storage ----------------------------------------------------
GARAGE_RPC_SECRET=6a0c269afcf8cda1c9a7e28fed5418f83ae579844c8bbf52fd14c2839b0bf563
GARAGE_ADMIN_TOKEN=dev-garage-admin-token
S3_BUCKET=coachin-photos
# Garage key format: "GK" + 24 hex chars; secret: 64 hex chars.
#   echo "GK$(openssl rand -hex 12)"   /   openssl rand -hex 32
S3_ACCESS_KEY_ID=GK1a53181b98bae77a1b2597a2
S3_SECRET_ACCESS_KEY=6f165e5e3ebc4c27ba4e1128b2a31edbbc81186abf1a21bd902f81e38822ca62

# --- Entry point (Caddy) -------------------------------------------------------
# Local: plain http on http://localhost:8080.
# VPS: SITE_ADDRESS=your.domain, HTTP_PORT=80, HTTPS_PORT=443 (automatic HTTPS).
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# --- API -----------------------------------------------------------------------
LOG_LEVEL=info
# Public origin, used in emailed links. VPS: https://your.domain
APP_BASE_URL=http://localhost:8080
# true on the VPS (HTTPS): Secure + __Host- session cookie. false for http://localhost.
COOKIE_SECURE=false
# Community surfaces (boards, clubs, groups) stay off, as on the legacy app.
FEATURE_COMMUNITY=false

# AI generation (training plans, meal plans, photo estimates): Claude first,
# Gemini as the fallback. Leave both empty and AI features report
# "temporarily unavailable". Models default to claude-sonnet-5 / gemini-2.5-flash.
CLAUDE_API_KEY=
CLAUDE_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Email ---------------------------------------------------------------------
# Local: Mailpit catches everything (read it at http://localhost:8025).
# VPS: your provider's SMTP settings (e.g. port 587 + SMTP_TLS=starttls + credentials).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=none
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=CoachIn <no-reply@coachin.local>
