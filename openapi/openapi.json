{
  "components": {
    "schemas": {
      "AddSchedulesInputBody": {
        "additionalProperties": false,
        "properties": {
          "days": {
            "description": "0=Sunday … 6=Saturday",
            "items": {
              "format": "int64",
              "type": "integer"
            },
            "maxItems": 7,
            "type": "array"
          },
          "endsOn": {
            "description": "Repeat until (YYYY-MM-DD), optional",
            "maxLength": 10,
            "type": "string"
          },
          "sportTypeId": {
            "format": "int64",
            "type": "integer"
          },
          "time": {
            "description": "HH:MM, optional",
            "maxLength": 8,
            "type": "string"
          }
        },
        "required": [
          "sportTypeId",
          "days"
        ],
        "type": "object"
      },
      "ChangeInputBody": {
        "additionalProperties": false,
        "properties": {
          "confirmPassword": {
            "maxLength": 256,
            "type": "string"
          },
          "currentPassword": {
            "maxLength": 256,
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "password",
          "confirmPassword"
        ],
        "type": "object"
      },
      "ErrorDetail": {
        "additionalProperties": false,
        "properties": {
          "location": {
            "description": "Where the error occurred, e.g. 'body.items[3].tags' or 'path.thing-id'",
            "type": "string"
          },
          "message": {
            "description": "Error message text",
            "type": "string"
          },
          "value": {
            "description": "The value at the given location"
          }
        },
        "type": "object"
      },
      "ErrorModel": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "description": "A human-readable explanation specific to this occurrence of the problem.",
            "examples": [
              "Property foo is required but is missing."
            ],
            "type": "string"
          },
          "errors": {
            "description": "Optional list of individual error details",
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array"
          },
          "instance": {
            "description": "A URI reference that identifies the specific occurrence of the problem.",
            "examples": [
              "https://example.com/error-log/abc123"
            ],
            "format": "uri",
            "type": "string"
          },
          "status": {
            "description": "HTTP status code",
            "examples": [
              400
            ],
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "A short, human-readable summary of the problem type. This value should not change between occurrences of the error.",
            "examples": [
              "Bad Request"
            ],
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "description": "A URI reference to human-readable documentation for the error.",
            "examples": [
              "https://example.com/errors/example"
            ],
            "format": "uri",
            "type": "string"
          }
        },
        "type": "object"
      },
      "Features": {
        "additionalProperties": false,
        "properties": {
          "community": {
            "type": "boolean"
          }
        },
        "required": [
          "community"
        ],
        "type": "object"
      },
      "ForgotInputBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "type": "object"
      },
      "HealthBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "description": "Always ok while the process is serving.",
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "LoginInputBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "MeBody": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          },
          "features": {
            "$ref": "#/components/schemas/Features"
          },
          "fullName": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "role": {
            "enum": [
              "student",
              "coach",
              "both",
              "admin"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "emailVerified",
          "fullName",
          "role",
          "features"
        ],
        "type": "object"
      },
      "PlanItemBody": {
        "additionalProperties": false,
        "properties": {
          "dayOfWeek": {
            "format": "int64",
            "maximum": 6,
            "minimum": 0,
            "type": "integer"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "$ref": "#/components/schemas/PlanItemDetailsBody"
          },
          "id": {
            "type": "string"
          },
          "isCompleted": {
            "type": "boolean"
          },
          "itemType": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "dayOfWeek",
          "itemType",
          "title",
          "description",
          "isCompleted",
          "details"
        ],
        "type": "object"
      },
      "PlanItemDetailsBody": {
        "additionalProperties": false,
        "properties": {
          "distanceKm": {
            "format": "double",
            "type": "number"
          },
          "durationMin": {
            "format": "double",
            "type": "number"
          },
          "notes": {
            "type": "string"
          },
          "paceMinKm": {
            "type": "string"
          },
          "videoQuery": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "QuotaBody": {
        "additionalProperties": false,
        "properties": {
          "doneThisWeek": {
            "description": "Distinct days this Mon–Sun week with a completed log of the sport",
            "format": "int64",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "sessionsPerWeek": {
            "format": "int64",
            "type": "integer"
          },
          "sportName": {
            "type": [
              "string",
              "null"
            ]
          },
          "sportTypeId": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "sportTypeId",
          "sportName",
          "sessionsPerWeek",
          "doneThisWeek"
        ],
        "type": "object"
      },
      "ReadyBody": {
        "additionalProperties": false,
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "Dependency name to \"ok\" or the failure message.",
            "type": "object"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "type": "object"
      },
      "RegisterInputBody": {
        "additionalProperties": false,
        "properties": {
          "confirmPassword": {
            "maxLength": 256,
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "type": "string"
          },
          "fullName": {
            "maxLength": 120,
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "confirmPassword",
          "fullName"
        ],
        "type": "object"
      },
      "ResetInputBody": {
        "additionalProperties": false,
        "properties": {
          "confirmPassword": {
            "maxLength": 256,
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "type": "string"
          },
          "token": {
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "token",
          "password",
          "confirmPassword"
        ],
        "type": "object"
      },
      "ResultBody": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "type": "string"
          },
          "status": {
            "enum": [
              "success",
              "info"
            ],
            "type": "string"
          }
        },
        "required": [
          "status",
          "message"
        ],
        "type": "object"
      },
      "RoutineBody": {
        "additionalProperties": false,
        "properties": {
          "estimatedWeeklyXp": {
            "format": "int64",
            "type": "integer"
          },
          "planItems": {
            "description": "Current week of the newest active AI plan (read-only here)",
            "items": {
              "$ref": "#/components/schemas/PlanItemBody"
            },
            "type": "array"
          },
          "quotas": {
            "items": {
              "$ref": "#/components/schemas/QuotaBody"
            },
            "type": "array"
          },
          "schedules": {
            "items": {
              "$ref": "#/components/schemas/ScheduleBody"
            },
            "type": "array"
          }
        },
        "required": [
          "schedules",
          "quotas",
          "planItems",
          "estimatedWeeklyXp"
        ],
        "type": "object"
      },
      "SaveQuotaInputBody": {
        "additionalProperties": false,
        "properties": {
          "sessionsPerWeek": {
            "format": "int64",
            "type": "integer"
          }
        },
        "required": [
          "sessionsPerWeek"
        ],
        "type": "object"
      },
      "ScheduleBody": {
        "additionalProperties": false,
        "properties": {
          "dayOfWeek": {
            "description": "0=Sunday … 6=Saturday",
            "format": "int64",
            "maximum": 6,
            "minimum": 0,
            "type": "integer"
          },
          "endsOn": {
            "format": "date",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "sportName": {
            "type": [
              "string",
              "null"
            ]
          },
          "sportTypeId": {
            "format": "int64",
            "type": [
              "integer",
              "null"
            ]
          },
          "time": {
            "description": "HH:MM",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "sportTypeId",
          "sportName",
          "dayOfWeek",
          "time",
          "endsOn"
        ],
        "type": "object"
      },
      "SportTypeBody": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "int64",
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "xpMultiplier": {
            "description": "Effective multiplier (unset counts as 1)",
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "id",
          "name",
          "xpMultiplier"
        ],
        "type": "object"
      },
      "TokenInputBody": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "maxLength": 128,
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "CoachIn API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultBody"
                }
              }
            },
            "description": "OK",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Sign in",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No Content",
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Sign out this browser",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/password/change": {
      "post": {
