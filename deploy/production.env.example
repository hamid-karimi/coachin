# CoachIn on the VPS. Copy to /srv/coachin/.env (chmod 600) and fill every <…>.
# Generate each secret with:  openssl rand -hex 32
# Runbook: deploy/README.md.

# --- Release images (published by the release workflow on each v* tag) -------------
API_IMAGE=ghcr.io/hamid-karimi/coachin-api:<version>
WEB_IMAGE=ghcr.io/hamid-karimi/coachin-web:<version>
BACKUP_IMAGE=ghcr.io/hamid-karimi/coachin-backup:<version>
# Nightly off-site backups on (the `backup` service).
COMPOSE_PROFILES=backup

# --- Domain + HTTPS (Caddy gets and renews the certificate) ------------------------
SITE_ADDRESS=<your.domain>
HTTP_PORT=80
HTTPS_PORT=443
APP_BASE_URL=https://<your.domain>
# Secure + __Host- session cookie.
COOKIE_SECURE=true

# --- Postgres ------------------------------------------------------------------------
POSTGRES_PASSWORD=<openssl rand -hex 32>
APP_DB_PASSWORD=<openssl rand -hex 32>
AUTH_DB_PASSWORD=<openssl rand -hex 32>

# --- Garage object storage -----------------------------------------------------------
GARAGE_RPC_SECRET=<openssl rand -hex 32>
GARAGE_ADMIN_TOKEN=<openssl rand -hex 32>
S3_BUCKET=coachin-photos
# Key id "GK" + 24 hex chars:  echo "GK$(openssl rand -hex 12)"
S3_ACCESS_KEY_ID=<GK…>
S3_SECRET_ACCESS_KEY=<openssl rand -hex 32>

# --- Features + AI -------------------------------------------------------------------
LOG_LEVEL=info
FEATURE_COMMUNITY=false
CLAUDE_API_KEY=<key>
CLAUDE_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
USDA_API_KEY=

# --- Email (your provider's SMTP) ----------------------------------------------------
SMTP_HOST=<smtp.provider.com>
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=<user>
SMTP_PASSWORD=<password>
MAIL_FROM=CoachIn <no-reply@<your.domain>>

# --- Off-site backups (nightly, encrypted, 14 days) ------------------------------------
BACKUP_S3_ENDPOINT=<https://s3.provider.com>
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=<bucket>
BACKUP_S3_ACCESS_KEY_ID=<key id>
BACKUP_S3_SECRET_ACCESS_KEY=<secret>
# Encrypts every backup. Keep a copy OFF the server (password manager): without it
# the backups can't be restored.
BACKUP_PASSPHRASE=<openssl rand -hex 32>
BACKUP_SCHEDULE=0 3 * * *
BACKUP_RETENTION_DAYS=14
# Optional: pinged after each successful backup (e.g. a healthchecks.io URL).
BACKUP_HEALTHCHECK_URL=

# --- Go-live import (7.2, one-time; then remove) -----------------------------------------
SUPABASE_DATABASE_URL=
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_BUCKET=body-photos
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
